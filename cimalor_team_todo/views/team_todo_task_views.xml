<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- KANBAN (grouped by stage): the user's main view -->
    <record id="view_team_todo_task_kanban" model="ir.ui.view">
        <field name="name">team.todo.task.kanban</field>
        <field name="model">team.todo.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id">
                <field name="is_done" />
                <templates>
                    <t t-name="card">
                        <div
              t-attf-class="fw-bold fs-6 #{record.is_done.raw_value ? 'text-decoration-line-through text-muted' : ''}"
            >
                            <field name="name" />
                        </div>
                        <!-- Deadline: hidden when there is no date and once
                             the task is finished, and coloured by the widget
                             (red when overdue, orange when it is today). -->
                        <field
              t-if="record.deadline.raw_value"
              name="deadline"
              widget="remaining_days"
              invisible="is_done"
            />
                        <div class="d-flex justify-content-between mt-2">
                            <field name="priority" widget="priority" />
                            <field name="user_id" widget="many2one_avatar_user" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- LIST (done tasks dimmed) -->
    <record id="view_team_todo_task_list" model="ir.ui.view">
        <field name="name">team.todo.task.list</field>
        <field name="model">team.todo.task</field>
        <field name="arch" type="xml">
            <list decoration-muted="is_done">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field
          name="stage_id"
          widget="badge"
          decoration-success="is_done"
        />
                <field name="is_done" string="Done" />
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_team_todo_task_form" model="ir.ui.view">
        <field name="name">team.todo.task.form</field>
        <field name="model">team.todo.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
            name="stage_id"
            widget="statusbar"
            options="{'clickable': 1}"
          />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Task title" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                name="user_id"
                widget="many2one_avatar_user"
                options="{'no_create': True}"
              />
                        </group>
                        <group>
                            <field name="deadline" />
                            <field name="priority" widget="priority" />
                            <field name="is_done" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- SEARCH: filters and group-bys -->
    <record id="view_team_todo_task_search" model="ir.ui.view">
        <field name="name">team.todo.task.search</field>
        <field name="model">team.todo.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="user_id" />
                <filter
          name="pending"
          string="Open"
          domain="[('is_done', '=', False)]"
        />
                <filter
          name="done"
          string="Done"
          domain="[('is_done', '=', True)]"
        />
                <separator />
                <filter
          name="my_tasks"
          string="My Tasks"
          domain="[('user_id', '=', uid)]"
        />
                <group>
                    <filter
            name="group_by_user"
            string="Assignee"
            context="{'group_by': 'user_id'}"
          />
                    <filter
            name="group_by_stage"
            string="Stage"
            context="{'group_by': 'stage_id'}"
          />
                </group>
            </search>
        </field>
    </record>

    <!-- User action: kanban by stage -->
    <record id="action_team_todo_task" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">team.todo.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_team_todo_task_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task
            </p>
        </field>
    </record>

    <!-- Administrator action: list grouped by assignee -->
    <record id="action_team_todo_task_manager" model="ir.actions.act_window">
        <field name="name">Tasks by Person</field>
        <field name="res_model">team.todo.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_team_todo_task_search" />
        <field name="context">{'search_default_group_by_user': 1}</field>
    </record>
</odoo>
