<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_team_todo_stage_list" model="ir.ui.view">
        <field name="name">team.todo.stage.list</field>
        <field name="model">team.todo.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="is_done" />
                <field name="fold" />
            </list>
        </field>
    </record>

    <record id="action_team_todo_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">team.todo.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
