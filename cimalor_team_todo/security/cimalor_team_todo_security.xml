<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Module category. In 18.0 the groups hang from it directly through
         category_id; res.groups.privilege only exists from 19.0. Because the two
         groups below form a chain (manager implies user), the user form shows
         them as a single User / Administrator selection. -->
    <record id="module_category_team_todo" model="ir.module.category">
        <field name="name">Team To-Do</field>
        <field name="sequence">20</field>
    </record>

    <!-- GROUPS -->
    <record id="group_team_todo_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_team_todo" />
    </record>

    <record id="group_team_todo_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_team_todo" />
        <!-- An administrator IS also a user (inherits its permissions) -->
        <field name="implied_ids" eval="[(4, ref('group_team_todo_user'))]" />
        <!-- Initial members are seeded by post_init_hook (see hooks.py): the
             Odoo administrators at install time. From then on they are managed
             by hand under Settings > Users. -->
    </record>

    <!-- Every internal user is a Team To-Do user, so the app shows up on install -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_team_todo_user'))]" />
    </record>

    <!-- RECORD RULES: which ROWS each role can see -->
    <record id="rule_task_user_own" model="ir.rule">
        <field name="name">Team To-Do: users see only their own tasks</field>
        <field name="model_id" ref="model_team_todo_task" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_team_todo_user'))]" />
    </record>

    <record id="rule_task_manager_all" model="ir.rule">
        <field name="name">Team To-Do: administrators see every task</field>
        <field name="model_id" ref="model_team_todo_task" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_team_todo_manager'))]" />
    </record>
</odoo>
