<?xml version="1.0" encoding="utf-8" ?>
<!--
    Starting reasons from spec §4.4, plus an Other per state that asks for a
    note. noupdate: the customer renames them, changes who they depend on or
    archives them, and an upgrade must not undo that.
-->
<odoo noupdate="1">
    <!--
        Sequences 10-50 for Waiting and 110-150 for On Hold: the list is
        sorted by its drag handle, so each block keeps its own range.
    -->
    <!-- What we are waiting for: something concrete and close. -->
    <record id="stop_reason_email_reply" model="cimalor.project.stop.reason">
        <field name="name">Reply to an email</field>
        <field name="reason_type">waiting</field>
        <field name="depends_on">customer</field>
        <field name="sequence">10</field>
    </record>
    <record id="stop_reason_delivery_approval" model="cimalor.project.stop.reason">
        <field name="name">Approval of a delivery</field>
        <field name="reason_type">waiting</field>
        <field name="depends_on">customer</field>
        <field name="sequence">20</field>
    </record>
    <record id="stop_reason_information" model="cimalor.project.stop.reason">
        <field name="name">Information or material</field>
        <field name="reason_type">waiting</field>
        <field name="depends_on">customer</field>
        <field name="sequence">30</field>
    </record>
    <record id="stop_reason_quote_approval" model="cimalor.project.stop.reason">
        <field name="name">Quote approval</field>
        <field name="reason_type">waiting</field>
        <field name="depends_on">customer</field>
        <field name="sequence">40</field>
    </record>
    <record id="stop_reason_waiting_other" model="cimalor.project.stop.reason">
        <field name="name">Other</field>
        <field name="reason_type">waiting</field>
        <field name="depends_on">customer</field>
        <field name="requires_note" eval="True" />
        <field name="sequence">50</field>
    </record>

    <!-- Why the project is on hold: a long, agreed pause. -->
    <record id="stop_reason_customer_postpones" model="cimalor.project.stop.reason">
        <field name="name">Customer postpones</field>
        <field name="reason_type">stopped</field>
        <field name="depends_on">customer</field>
        <field name="sequence">110</field>
    </record>
    <record id="stop_reason_no_budget" model="cimalor.project.stop.reason">
        <field name="name">Lack of budget</field>
        <field name="reason_type">stopped</field>
        <field name="depends_on">customer</field>
        <field name="sequence">120</field>
    </record>
    <record id="stop_reason_internal_priority" model="cimalor.project.stop.reason">
        <field name="name">Internal priority</field>
        <field name="reason_type">stopped</field>
        <field name="depends_on">internal</field>
        <field name="sequence">130</field>
    </record>
    <record id="stop_reason_technical_block" model="cimalor.project.stop.reason">
        <field name="name">Technical blocker</field>
        <field name="reason_type">stopped</field>
        <field name="depends_on">internal</field>
        <field name="sequence">140</field>
    </record>
    <record id="stop_reason_stopped_other" model="cimalor.project.stop.reason">
        <field name="name">Other</field>
        <field name="reason_type">stopped</field>
        <field name="depends_on">internal</field>
        <field name="requires_note" eval="True" />
        <field name="sequence">150</field>
    </record>
</odoo>
