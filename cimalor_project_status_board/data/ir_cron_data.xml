<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Once a day, apply the Excluded Projects and Excluded Tasks filters
        again, and put each hour bank in its place: a filter may use a field
        that changes without a write (a stored computed field, a value on a
        related record), which no write() override sees.
    -->
    <record id="ir_cron_refresh_excluded_projects" model="ir.cron">
        <field name="name">Project Status Board: refresh excluded projects and tasks</field>
        <field name="model_id" ref="project.model_project_project" />
        <field name="state">code</field>
        <field name="code">model._cimalor_daily_refresh()</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
