<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="cimalor_project_status_board.TeamActivity">
        <!-- o_action gives the content the window's height, so it scrolls. -->
        <div class="o_action">
        <Layout display="{ controlPanel: {} }">
            <div class="o_cimalor_activity p-3 h-100 overflow-auto">
                <t t-if="state.loading">
                    <div class="text-muted">Loading…</div>
                </t>
                <t t-elif="!state.data.people.length">
                    <div class="o_view_nocontent">
                        <div class="o_nocontent_help">
                            <p class="o_view_nocontent_smiling_face">Nobody to show</p>
                            <p>Link the users of Project to their employee to see their activity here.</p>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="d-flex flex-wrap gap-3 align-items-center small text-muted mb-2">
                        <span><span class="o_cimalor_activity_swatch bg-primary" /> Logged hours</span>
                        <span>
                            <span class="o_cimalor_activity_swatch o_cimalor_activity_open" />
                            Timer running now
                        </span>
                        <span>
                            <span class="o_cimalor_activity_swatch o_cimalor_activity_swatch_gauge" />
                            Capacity of the day
                        </span>
                        <span>
                            Last working days, today included. Timesheets keep hours per day,
                            so each day shows a total.
                        </span>
                    </div>
                    <div class="o_cimalor_activity_grid">
                        <!-- Header: one column per day, then the total. -->
                        <div class="o_cimalor_activity_row o_cimalor_activity_header">
                            <div class="o_cimalor_activity_label" />
                            <t t-foreach="state.data.days" t-as="day" t-key="day.date">
                                <div t-attf-class="o_cimalor_activity_day {{ day.today ? 'o_cimalor_activity_today' : '' }}">
                                    <div class="fw-bold">
                                        <t t-out="dayName(day)" />
                                        <t t-if="day.today"> · today</t>
                                    </div>
                                    <div t-out="dayMonth(day)" />
                                </div>
                            </t>
                            <div class="o_cimalor_activity_total">Total</div>
                        </div>
                        <!-- One card per person, so the eye can tell where each one starts. -->
                        <div class="o_cimalor_activity_card" t-foreach="state.data.people" t-as="person" t-key="person.user_id">
                            <!-- Person: what they are on now, and each day against their capacity. -->
                            <div class="o_cimalor_activity_row o_cimalor_activity_person_row">
                                <div class="o_cimalor_activity_label">
                                    <div class="o_cimalor_activity_name fw-bold" t-out="person.name" />
                                    <div t-if="person.timer" class="small fw-semibold text-success">
                                        <span class="o_cimalor_activity_dot" />
                                        <t t-out="nowText(person)" />
                                    </div>
                                    <div t-else="" class="small text-muted">
                                        ○ <t t-out="lastEntryText(person)" />
                                    </div>
                                </div>
                                <t t-foreach="state.data.days" t-as="day" t-key="day.date">
                                    <div t-attf-class="o_cimalor_activity_day {{ day.today ? 'o_cimalor_activity_today' : '' }}">
                                        <div class="small text-center" t-out="dayText(person, day_index)" />
                                        <div t-if="person.capacity[day_index]" class="o_cimalor_activity_gauge">
                                            <div
                                                t-attf-class="o_cimalor_activity_gauge_fill {{ isFull(person, day_index) ? 'bg-success' : 'bg-primary' }}"
                                                t-att-style="gaugeStyle(person, day_index)"
                                            />
                                        </div>
                                    </div>
                                </t>
                                <div class="o_cimalor_activity_total">
                                    <div class="fw-bold" t-out="hoursText(total(person))" />
                                    <div t-if="totalCapacity(person)" class="small text-muted">
                                        of <t t-out="hoursText(totalCapacity(person))" />
                                    </div>
                                </div>
                            </div>
                            <!-- One row per project: the running timer's first, then the most hours. -->
                            <t t-foreach="person.rows" t-as="row" t-key="row.project_id">
                                <div class="o_cimalor_activity_row">
                                    <div class="o_cimalor_activity_label o_cimalor_activity_project text-truncate" t-att-title="row.project">
                                        <span t-if="row.open" class="o_cimalor_activity_dot" />
                                        <t t-out="row.project" />
                                    </div>
                                    <t t-foreach="state.data.days" t-as="day" t-key="day.date">
                                        <div
                                            t-attf-class="o_cimalor_activity_day o_cimalor_activity_cell {{ day.today ? 'o_cimalor_activity_today' : '' }}"
                                            t-on-click="() => this.openProject(row)"
                                        >
                                            <span
                                                t-if="row.hours[day_index]"
                                                t-attf-class="o_cimalor_activity_bar bg-primary {{ openHours(person, row, day_index) ? 'o_cimalor_activity_bar_joined' : '' }}"
                                                t-att-style="barStyle(person, day_index, row.hours[day_index])"
                                            />
                                            <span
                                                t-if="openHours(person, row, day_index)"
                                                class="o_cimalor_activity_bar o_cimalor_activity_open"
                                                t-att-style="barStyle(person, day_index, openHours(person, row, day_index))"
                                            />
                                            <span class="o_cimalor_activity_hours" t-out="cellText(person, row, day_index)" />
                                        </div>
                                    </t>
                                    <div class="o_cimalor_activity_total" t-out="rowText(person, row)" />
                                </div>
                            </t>
                            <div t-if="person.others" class="o_cimalor_activity_row text-muted">
                                <div class="o_cimalor_activity_label o_cimalor_activity_project" t-out="othersText(person)" />
                                <t t-foreach="state.data.days" t-as="day" t-key="day.date">
                                    <div t-attf-class="o_cimalor_activity_day {{ day.today ? 'o_cimalor_activity_today' : '' }}">
                                        <t t-if="person.others.hours[day_index]">
                                            <span
                                                class="o_cimalor_activity_bar bg-secondary"
                                                t-att-style="barStyle(person, day_index, person.others.hours[day_index])"
                                            />
                                            <span class="o_cimalor_activity_hours" t-out="hoursText(person.others.hours[day_index])" />
                                        </t>
                                    </div>
                                </t>
                                <div class="o_cimalor_activity_total" t-out="hoursText(rowTotal(person.others))" />
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </Layout>
        </div>
    </t>
</templates>
