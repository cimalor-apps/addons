<?xml version="1.0" encoding="utf-8" ?>
<!--
    Reporting › Capacity: one line per person. A list, not a pivot: the
    capacity figures are computed when read and cannot be grouped or summed
    by the database.
-->
<odoo>
    <record id="view_cimalor_project_capacity_report_list" model="ir.ui.view">
        <field name="name">cimalor.project.capacity.report.list</field>
        <field name="model">cimalor.project.capacity.report</field>
        <field name="arch" type="xml">
            <list string="Capacity" create="0" edit="0" delete="0">
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="daily_capacity" widget="float_time" />
                <field name="weekly_capacity" widget="float_time" />
                <field name="pending_hours" widget="float_time" sum="Total" />
                <field name="weeks_of_work" digits="[16, 1]" />
                <field name="queue_end_date" />
                <field name="paused_hours" widget="float_time" sum="Total" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_cimalor_project_capacity_report_search" model="ir.ui.view">
        <field name="name">cimalor.project.capacity.report.search</field>
        <field name="model">cimalor.project.capacity.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />
                <filter
                    string="With Pending Work"
                    name="with_work"
                    domain="[('pending_hours', '>', 0)]"
                />
            </search>
        </field>
    </record>

    <record id="action_cimalor_project_capacity_report" model="ir.actions.act_window">
        <field name="name">Capacity</field>
        <field name="res_model">cimalor.project.capacity.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_cimalor_project_capacity_report_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody to show</p>
            <p>
                Each employee with a user appears here, with their capacity for
                tasks and the day their pending work ends.
            </p>
        </field>
    </record>
</odoo>
