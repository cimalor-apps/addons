<?xml version="1.0" encoding="utf-8" ?>
<!--
    The board and the project form of the app. They are new primary views of
    project.project, not inheritances of Project's ones: the card and the form
    are a different screen, and the Project app must keep working exactly as
    before.

    priority 100 is what keeps them out of Project. When an action does not
    name its view, Odoo opens the one with the lowest priority; Project's
    views have 16 or less, so they keep winning everywhere except in this
    app's action, which names these views explicitly.
-->
<odoo>
    <!--
        No `action`/`type` on <kanban>: clicking a card then opens the record
        in the form below. Project's kanban sets them to open the tasks.
        The drag between columns is Odoo's own: it writes stage_id, and
        project.project.write() logs the change.
    -->
    <record id="view_project_project_kanban" model="ir.ui.view">
        <field name="name">project.project.kanban.cimalor_project_status_board</field>
        <field name="model">project.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="stage_id"
                class="o_kanban_small_column"
                quick_create="false"
                sample="1"
            >
                <field name="cimalor_state_type" />
                <field name="cimalor_missing_state_data" />
                <field name="cimalor_follow_up_overdue" />
                <field name="cimalor_depends_on" />
                <field name="cimalor_follow_up_date" />
                <field name="cimalor_last_comment" />
                <field name="cimalor_last_comment_date" />
                <field name="cimalor_last_comment_user_id" />
                <field name="cimalor_last_comment_first_name" />
                <field name="cimalor_last_comment_day" />
                <field name="cimalor_timer_running_by" />
                <field name="cimalor_hours_health" />
                <field name="cimalor_days_health" />
                <field name="cimalor_days_margin" />
                <field name="cimalor_forecast_end_date" />
                <field name="cimalor_late_by" />
                <field name="date" />
                <templates>
                    <!--
                        Odoo stacks grouped cards edge to edge (margin-bottom
                        -1px, shared border). The class of the card template
                        goes on the card itself in 18.0 and 19.0, so Bootstrap
                        utilities separate them without any stylesheet.
                    -->
                    <t t-name="card" class="mb-2 rounded">
                        <main>
                            <!--
                                Green dot top right while somebody times a task
                                of the project: Odoo's own status "LED"
                                (o_status_green), the one Project uses for
                                tasks. Who, on hover.
                            -->
                            <!--
                                Name and customer on one line each: Bootstrap's
                                text-truncate cuts them with an ellipsis (its
                                overflow also lets the flex item shrink), and the
                                full text shows on hover.
                            -->
                            <div class="d-flex align-items-start gap-2">
                                <div
                                    class="fw-bold fs-5 text-truncate"
                                    t-att-title="record.name.value"
                                >
                                    <field name="name" />
                                </div>
                                <span
                                    t-if="record.cimalor_timer_running_by.raw_value"
                                    class="o_status o_status_green d-inline-block ms-auto mt-2 flex-shrink-0"
                                    role="img"
                                    t-att-title="record.cimalor_timer_running_by.value"
                                    t-att-aria-label="record.cimalor_timer_running_by.value"
                                />
                            </div>
                            <div
                                t-if="record.partner_id.raw_value"
                                class="text-muted text-truncate"
                                t-att-title="record.partner_id.value"
                            >
                                <field name="partner_id" />
                            </div>
                            <field name="cimalor_state_summary" class="small mt-1" />
                            <!--
                                The last timesheet comment as "Ana · 12/11 ·
                                comment": first name and dd/mm come ready
                                from the model, on one line (text-truncate);
                                the full comment on hover.
                            -->
                            <div
                                t-if="record.cimalor_last_comment.raw_value"
                                class="small text-muted text-truncate mt-1"
                                t-att-title="record.cimalor_last_comment.value"
                            >
                                <i
                                    class="fa fa-comment-o me-1"
                                    role="img"
                                    aria-label="Last comment"
                                />
                                <span
                                    class="fw-semibold"
                                    t-out="record.cimalor_last_comment_first_name.value"
                                />
                                <t t-out="' · ' + record.cimalor_last_comment_day.value + ' · '" />
                                <t t-out="record.cimalor_last_comment.value" />
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <span
                                    t-if="record.cimalor_missing_state_data.raw_value"
                                    class="badge rounded-pill text-bg-warning"
                                >Data missing</span>
                                <!-- On Hold only: Waiting always depends on the customer. -->
                                <span
                                    t-if="record.cimalor_state_type.raw_value == 'stopped' and record.cimalor_depends_on.raw_value"
                                    t-attf-class="badge rounded-pill {{ record.cimalor_depends_on.raw_value == 'customer' ? 'text-bg-info' : 'text-bg-light' }}"
                                >
                                    Depends on: <t
                                        t-out="record.cimalor_depends_on.value"
                                    />
                                </span>
                                <span
                                    t-if="record.cimalor_follow_up_date.raw_value"
                                    t-attf-class="badge rounded-pill {{ record.cimalor_follow_up_overdue.raw_value ? 'text-bg-danger' : 'text-bg-light' }}"
                                >
                                    Follow-up <field name="cimalor_follow_up_date" />
                                </span>
                                <!--
                                    Hours margin as a traffic light: red over
                                    budget, amber tight, green with room. Not
                                    shown without allocated hours (grey on the
                                    form) nor on finished projects.
                                -->
                                <span
                                    t-if="['over', 'tight', 'ok'].includes(record.cimalor_hours_health.raw_value)"
                                    t-attf-class="badge rounded-pill d-inline-flex align-items-center {{ record.cimalor_hours_health.raw_value == 'over' ? 'text-bg-danger' : record.cimalor_hours_health.raw_value == 'tight' ? 'text-bg-warning' : 'text-bg-success' }}"
                                    t-att-title="record.cimalor_hours_health.value"
                                >
                                    <i
                                        class="fa fa-clock-o me-1"
                                        role="img"
                                        aria-label="Hours margin"
                                    />
                                    <field name="cimalor_hours_margin" widget="float_time" />
                                </span>
                                <!--
                                    Days margin, the same traffic light: working
                                    days between the forecast end and the
                                    delivery date. Who it is late because of, on
                                    hover. "Late" without a number when the work
                                    goes beyond the queue's horizon.
                                -->
                                <span
                                    t-if="['late', 'tight', 'ok'].includes(record.cimalor_days_health.raw_value)"
                                    t-attf-class="badge rounded-pill d-inline-flex align-items-center {{ record.cimalor_days_health.raw_value == 'late' ? 'text-bg-danger' : record.cimalor_days_health.raw_value == 'tight' ? 'text-bg-warning' : 'text-bg-success' }}"
                                    t-att-title="record.cimalor_late_by.raw_value ? record.cimalor_days_health.value + ': ' + record.cimalor_late_by.value : record.cimalor_days_health.value"
                                >
                                    <i
                                        class="fa fa-calendar me-1"
                                        role="img"
                                        aria-label="Days margin"
                                    />
                                    <t t-if="record.cimalor_forecast_end_date.raw_value">
                                        <t
                                            t-out="(record.cimalor_days_margin.raw_value > 0 ? '+' : '') + record.cimalor_days_margin.raw_value"
                                        /> d
                                    </t>
                                    <t t-else="">Late</t>
                                </span>
                            </div>
                        </main>
                        <footer class="pt-1">
                            <span class="small text-muted">
                                <field name="closed_task_count" /> of <field
                                    name="task_count"
                                /> tasks
                            </span>
                            <span t-if="record.date.raw_value" class="small text-muted ms-2">
                                Due <field name="date" />
                            </span>
                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                class="ms-auto"
                            />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_project_project_form" model="ir.ui.view">
        <field name="name">project.project.form.cimalor_project_status_board</field>
        <field name="model">project.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Project">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Brochure automation" />
                        </h1>
                        <!-- The same sentence as on the kanban card. -->
                        <field
                            name="cimalor_state_summary"
                            class="fs-5"
                            invisible="not cimalor_state_summary"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="user_id" widget="many2one_avatar_user" />
                        </group>
                        <group>
                            <field name="date" string="Delivery Date" />
                            <field name="company_id" invisible="1" />
                        </group>
                    </group>
                    <!--
                        The hours of the project: the budget (Project's own
                        allocated hours, editable), what is spent, what is
                        left on the open tasks, and the margin between them.
                    -->
                    <group name="cimalor_hours">
                        <group>
                            <field
                                name="allocated_hours"
                                widget="float_time"
                                string="Allocated Hours"
                            />
                            <field name="effective_hours" widget="float_time" string="Spent" />
                        </group>
                        <group>
                            <field name="cimalor_pending_hours" widget="float_time" />
                            <label for="cimalor_hours_margin" />
                            <div class="d-flex align-items-center gap-2">
                                <field
                                    name="cimalor_hours_margin"
                                    widget="float_time"
                                    class="oe_inline"
                                    invisible="cimalor_hours_health in (False, 'no_budget')"
                                />
                                <field
                                    name="cimalor_hours_health"
                                    widget="badge"
                                    decoration-danger="cimalor_hours_health == 'over'"
                                    decoration-warning="cimalor_hours_health == 'tight'"
                                    decoration-success="cimalor_hours_health == 'ok'"
                                    invisible="not cimalor_hours_health"
                                />
                            </div>
                            <field
                                name="cimalor_forecast_end_date"
                                invisible="not cimalor_forecast_end_date"
                            />
                            <label for="cimalor_days_margin" invisible="not cimalor_days_health" />
                            <div
                                class="d-flex align-items-center gap-2"
                                invisible="not cimalor_days_health"
                            >
                                <field
                                    name="cimalor_days_margin"
                                    class="oe_inline"
                                    invisible="not cimalor_forecast_end_date or cimalor_days_health == 'no_data'"
                                />
                                <field
                                    name="cimalor_days_health"
                                    widget="badge"
                                    decoration-danger="cimalor_days_health == 'late'"
                                    decoration-warning="cimalor_days_health == 'tight'"
                                    decoration-success="cimalor_days_health == 'ok'"
                                />
                            </div>
                            <field name="cimalor_late_by" invisible="not cimalor_late_by" />
                        </group>
                    </group>

                    <!--
                        The state as a row of buttons, one per stage, like the
                        board's columns. The widget is registered as
                        "selection_badge" in 18.0 and 19.0 (its source folder
                        is badge_selection). It reads the stages with the same
                        company domain as Project's status bar.
                    -->
                    <separator string="Project State" />
                    <field
                        name="stage_id"
                        widget="selection_badge"
                        domain="[('company_id', 'in', (company_id, False))]"
                        nolabel="1"
                    />
                    <field name="cimalor_state_type" invisible="1" />
                    <field name="cimalor_reason_requires_note" invisible="1" />

                    <!--
                        Waiting and On Hold ask for their data here. It is
                        required in this view only, never with a constraint:
                        the drag, imports and automatic changes must still be
                        able to move a project without it (spec §6.1).
                    -->
                    <!--
                        Who an On Hold project depends on, highlighted when it
                        is the customer, as on the card. Waiting is always the
                        customer, so it is neither asked nor shown. Three spans
                        with a fixed text each keep every sentence translatable
                        whole.
                    -->
                    <div
                        class="d-flex gap-2 mb-2"
                        invisible="cimalor_state_type not in ('waiting', 'stopped')"
                    >
                        <span
                            class="badge rounded-pill text-bg-info"
                            invisible="cimalor_state_type != 'stopped' or cimalor_depends_on != 'customer'"
                        >Depends on the customer</span>
                        <span
                            class="badge rounded-pill text-bg-light"
                            invisible="cimalor_state_type != 'stopped' or cimalor_depends_on != 'supplier'"
                        >Depends on a supplier</span>
                        <span
                            class="badge rounded-pill text-bg-light"
                            invisible="cimalor_state_type != 'stopped' or cimalor_depends_on != 'internal'"
                        >Depends on us</span>
                        <span
                            class="badge rounded-pill text-bg-warning"
                            invisible="not cimalor_missing_state_data"
                        >Data missing</span>
                    </div>
                    <field name="cimalor_missing_state_data" invisible="1" />
                    <group
                        name="cimalor_state_data"
                        invisible="cimalor_state_type not in ('waiting', 'stopped')"
                    >
                        <group>
                            <field
                                name="cimalor_reason_id"
                                required="cimalor_state_type in ('waiting', 'stopped')"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field
                                name="cimalor_depends_on"
                                invisible="cimalor_state_type != 'stopped'"
                            />
                        </group>
                        <group>
                            <field
                                name="cimalor_follow_up_date"
                                invisible="cimalor_state_type != 'waiting'"
                                required="cimalor_state_type == 'waiting'"
                            />
                            <field
                                name="cimalor_restart_date"
                                invisible="cimalor_state_type != 'stopped'"
                                required="cimalor_state_type == 'stopped'"
                            />
                        </group>
                        <field
                            name="cimalor_state_note"
                            required="cimalor_reason_requires_note"
                            placeholder="Explain the reason"
                            colspan="2"
                        />
                    </group>

                    <notebook>
                        <page string="Tasks" name="cimalor_open_tasks">
                            <field name="cimalor_open_task_ids">
                                <list editable="bottom">
                                    <!--
                                        Drag to reorder when needed. It writes the
                                        task's own `sequence`, the same one
                                        Project's task views use (handle as in
                                        project_task_views.xml). Starred tasks still
                                        come first: project.task orders by priority
                                        before sequence.
                                    -->
                                    <field name="sequence" widget="handle" />
                                    <field name="cimalor_is_done" nolabel="1" />
                                    <field name="name" />
                                    <field
                                        name="user_ids"
                                        widget="many2many_avatar_user"
                                        optional="show"
                                    />
                                    <field
                                        name="allocated_hours"
                                        widget="float_time"
                                        string="Planned"
                                    />
                                    <field
                                        name="effective_hours"
                                        widget="float_time"
                                        string="Spent"
                                    />
                                    <!-- date_deadline is a datetime: show the day only -->
                                    <field
                                        name="date_deadline"
                                        options="{'show_time': false}"
                                        optional="show"
                                    />
                                    <!--
                                        The current user's timer: a live counter
                                        while it runs, play to start, stop to log
                                        the time. Hidden on unsaved lines, which
                                        have no task to time yet.
                                    -->
                                    <field
                                        name="cimalor_timer_start"
                                        widget="cimalor_timer"
                                        string=" "
                                    />
                                    <button
                                        name="action_cimalor_timer_start"
                                        type="object"
                                        icon="fa-play"
                                        title="Start timer"
                                        invisible="cimalor_timer_start or not id"
                                    />
                                    <button
                                        name="action_cimalor_timer_stop"
                                        type="object"
                                        icon="fa-stop"
                                        title="Stop timer"
                                        class="text-danger"
                                        invisible="not cimalor_timer_start"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Closed Tasks" name="cimalor_closed_tasks">
                            <field name="cimalor_closed_task_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="cimalor_is_done" nolabel="1" />
                                    <field name="name" readonly="1" />
                                    <field
                                        name="allocated_hours"
                                        widget="float_time"
                                        string="Planned"
                                        readonly="1"
                                    />
                                    <field
                                        name="effective_hours"
                                        widget="float_time"
                                        string="Spent"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="State History" name="cimalor_state_history">
                            <field name="cimalor_state_log_ids" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!--
        Project's search view plus the hours health, as a copy (mode primary)
        used only by the app's actions: Project's own search view stays as it
        was.
    -->
    <record id="view_project_project_search" model="ir.ui.view">
        <field name="name">project.project.search.cimalor_project_status_board</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <filter name="unassigned_projects" position="after">
                <separator />
                <filter
                    string="Over Budget"
                    name="cimalor_hours_over"
                    domain="[('cimalor_hours_health', '=', 'over')]"
                />
                <filter
                    string="Hours at Risk"
                    name="cimalor_hours_at_risk"
                    domain="[('cimalor_hours_health', 'in', ['over', 'tight'])]"
                />
                <separator />
                <filter
                    string="Late"
                    name="cimalor_days_late"
                    domain="[('cimalor_days_health', '=', 'late')]"
                />
                <filter
                    string="Date at Risk"
                    name="cimalor_date_at_risk"
                    domain="[('cimalor_days_health', 'in', ['late', 'tight'])]"
                />
            </filter>
            <filter name="groupby_stage" position="after">
                <filter
                    string="Hours Health"
                    name="cimalor_groupby_hours_health"
                    context="{'group_by': 'cimalor_hours_health'}"
                />
            </filter>
        </field>
    </record>

    <!--
        The app's action names its kanban and form; the list is Project's own.
        Projects matching the Excluded Projects setting (hour banks…) are left
        out of every board and report of the app; Project still shows them.
        Project templates (is_template, new in 19.0) are not real projects and
        are left out, as in Project's own action.
    -->
    <record id="action_project_project" model="ir.actions.act_window">
        <field name="name">All Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field
            name="domain"
        >[('is_template', '=', False), ('cimalor_excluded', '=', False)]</field>
        <field name="search_view_id" ref="view_project_project_search" />
        <field
            name="view_ids"
            eval="[
                Command.clear(),
                Command.create({'view_mode': 'kanban', 'view_id': ref('view_project_project_kanban')}),
                Command.create({'view_mode': 'list'}),
                Command.create({'view_mode': 'form', 'view_id': ref('view_project_project_form')}),
            ]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first project</p>
            <p>
                Each project is a card, and each column is a state. Drag a card to
                change its state; Waiting and On Hold ask for a reason and a date.
            </p>
        </field>
    </record>

    <!--
        The same board, with the projects the user manages or has tasks in:
        the same projects they can change the state of (see the write rule in
        security/). A domain, not a removable filter, because it is a menu of
        its own; "All Projects" is next to it.
    -->
    <record id="action_project_project_my" model="ir.actions.act_window">
        <field name="name">My Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field
            name="domain"
        >[('is_template', '=', False), ('cimalor_excluded', '=', False), '|', ('user_id', '=', uid), ('tasks.user_ids', 'in', uid)]</field>
        <field name="search_view_id" ref="view_project_project_search" />
        <field
            name="view_ids"
            eval="[
                Command.clear(),
                Command.create({'view_mode': 'kanban', 'view_id': ref('view_project_project_kanban')}),
                Command.create({'view_mode': 'list'}),
                Command.create({'view_mode': 'form', 'view_id': ref('view_project_project_form')}),
            ]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No projects of yours yet</p>
            <p>
                Here are the projects you manage or have tasks in. All Projects shows
                the rest.
            </p>
        </field>
    </record>

    <!--
        Reporting › Date Risk: the projects with their forecast end and days
        margin, at risk first by default. A list of projects rather than a
        report model: the figures are computed when read, so it cannot be
        grouped or sorted by them; the filter is the useful part.
    -->
    <record id="view_project_project_date_risk_list" model="ir.ui.view">
        <field name="name">project.project.list.cimalor_date_risk</field>
        <field name="model">project.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Date Risk" create="0">
                <field name="name" />
                <field name="partner_id" optional="show" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field name="stage_id" />
                <field name="date" string="Delivery Date" />
                <field name="cimalor_forecast_end_date" />
                <field name="cimalor_days_margin" />
                <field
                    name="cimalor_days_health"
                    widget="badge"
                    decoration-danger="cimalor_days_health == 'late'"
                    decoration-warning="cimalor_days_health == 'tight'"
                    decoration-success="cimalor_days_health == 'ok'"
                />
                <field name="cimalor_late_by" />
                <field
                    name="cimalor_hours_health"
                    widget="badge"
                    decoration-danger="cimalor_hours_health == 'over'"
                    decoration-warning="cimalor_hours_health == 'tight'"
                    decoration-success="cimalor_hours_health == 'ok'"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="action_project_project_date_risk" model="ir.actions.act_window">
        <field name="name">Date Risk</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('is_template', '=', False), ('cimalor_excluded', '=', False), ('cimalor_state_type', 'not in', ['done', 'stopped'])]</field>
        <field name="context">{'search_default_cimalor_date_at_risk': 1}</field>
        <field name="search_view_id" ref="view_project_project_search" />
        <field
            name="view_ids"
            eval="[
                Command.clear(),
                Command.create({'view_mode': 'list', 'view_id': ref('view_project_project_date_risk_list')}),
                Command.create({'view_mode': 'form', 'view_id': ref('view_project_project_form')}),
            ]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No project at risk</p>
            <p>
                Every project in progress is forecast to arrive on time. Remove the
                filter to see them all.
            </p>
        </field>
