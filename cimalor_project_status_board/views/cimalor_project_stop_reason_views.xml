<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_cimalor_project_stop_reason_list" model="ir.ui.view">
        <field name="name">cimalor.project.stop.reason.list</field>
        <field name="model">cimalor.project.stop.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="reason_type" />
                <field name="depends_on" />
                <field name="requires_note" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_cimalor_project_stop_reason_search" model="ir.ui.view">
        <field name="name">cimalor.project.stop.reason.search</field>
        <field name="model">cimalor.project.stop.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    string="Waiting"
                    name="waiting"
                    domain="[('reason_type', '=', 'waiting')]"
                />
                <filter
                    string="On Hold"
                    name="stopped"
                    domain="[('reason_type', '=', 'stopped')]"
                />
                <separator />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                <group>
                    <filter
                        string="Used For"
                        name="group_reason_type"
                        context="{'group_by': 'reason_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_cimalor_project_stop_reason" model="ir.actions.act_window">
        <field name="name">Waiting and On Hold Reasons</field>
        <field name="res_model">cimalor.project.stop.reason</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_reason_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a reason</p>
            <p>
                Reasons explain why a project is waiting or on hold, and who it
                depends on.
            </p>
        </field>
    </record>
</odoo>
