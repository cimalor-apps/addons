<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        A block of its own in Project's settings page, where Project
        administrators already set up projects. The filter uses Odoo's domain
        editor, so each company picks its own field (an hour bank flag, a tag,
        a type of project).
    -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cimalor_project_status_board</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">
                <block title="Project Status Board" name="cimalor_project_status_board">
                    <!-- Full width (col-lg-12, as Timesheets' own setting): the rules need room. -->
                    <setting
                        id="cimalor_excluded_projects"
                        class="col-lg-12"
                        string="Excluded Projects"
                        help="Projects matching this filter, such as hour banks, are left out of the boards, the reports and everybody's workload."
                    >
                        <field
                            name="cimalor_excluded_project_domain"
                            widget="domain"
                            options="{'model': 'project.project'}"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
