<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        A block of its own in Project's settings page, where Project
        administrators already set up projects. The filter uses Odoo's domain
        editor, so each company picks its own field (an hour bank flag, a tag,
        a type of project).
    -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cimalor_project_status_board</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">
                <block title="Project Status Board" name="cimalor_project_status_board">
                    <!-- Full width (col-lg-12, as Timesheets' own setting): the rules need room. -->
                    <setting
                        id="cimalor_excluded_projects"
                        class="col-lg-12"
                        string="Excluded Projects"
                        help="Projects matching this filter are left out of the boards, the reports and everybody's workload."
                    >
                        <field
                            name="cimalor_excluded_project_domain"
                            widget="domain"
                            options="{'model': 'project.project'}"
                        />
                    </setting>
                    <setting
                        id="cimalor_excluded_tasks"
                        class="col-lg-12"
                        string="Excluded Tasks"
                        help="Tasks matching this filter, such as the ones holding an hour bank's balance, never count as work. A project with such tasks is an hour bank: it goes on hold by itself without other open tasks, and back to In Progress with the next one."
                    >
                        <field
                            name="cimalor_excluded_task_domain"
                            widget="domain"
                            options="{'model': 'project.task'}"
                        />
                    </setting>
                    <setting
                        id="cimalor_excluded_employees"
                        string="Employees Left Out of the Reports"
                        help="They do not appear in Team Activity, Workload, Capacity, Queue by Person or the daily email, such as managers who do not log project work. Their tasks still count for the projects' margins."
                    >
                        <!-- Only employees with a user: the reports show nobody else. -->
                        <field
                            name="cimalor_excluded_employee_ids"
                            widget="many2many_tags"
                            domain="[('user_id', '!=', False)]"
                        />
                    </setting>
                    <setting
                        id="cimalor_digest"
                        string="Daily Email"
                        help="A summary of the board every day: team activity, projects at risk and overdue follow-ups. Each recipient gets what they can see in the reports."
                    >
                        <div class="row mt-2">
                            <label for="cimalor_digest_user_ids" string="Recipients" class="col-lg-4 o_light_label" />
                            <field
                                name="cimalor_digest_user_ids"
                                widget="many2many_tags"
                                domain="[('share', '=', False)]"
                                class="col-lg-8"
                            />
                        </div>
                        <div class="row">
                            <label for="cimalor_digest_next_send" string="Next Email" class="col-lg-4 o_light_label" />
                            <field name="cimalor_digest_next_send" class="col-lg-8" />
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
