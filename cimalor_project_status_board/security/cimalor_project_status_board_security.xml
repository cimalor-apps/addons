<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Same domain as Project's own multi-company rule on projects: a user
        only sees the history of projects of their companies, or of projects
        shared by all companies.
    -->
    <record id="cimalor_project_state_log_comp_rule" model="ir.rule">
        <field name="name">Project State Change: multi-company</field>
        <field name="model_id" ref="model_cimalor_project_state_log" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
